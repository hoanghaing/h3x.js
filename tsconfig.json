{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "declaration": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "h3x/core": ["./src/core/index.ts"],
      "h3x/three": ["./src/three/index.ts"]
    }
  },
  "include": ["src", "tests", "examples"]
}
