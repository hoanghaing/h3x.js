      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22",
    "@types/three": "^0.187.0",
    "eslint": "^9.39.5",
    "jsdom": "^26.1.0",
    "prettier": "^3.10.1",
    "three": "^0.187.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.4.6",
    "vite-plugin-dts": "^5.1.2",
